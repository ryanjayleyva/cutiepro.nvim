# CutiePro colors for zsh-syntax-highlighting and zsh-autosuggestions
# Use this INSTEAD of cutiepro.zsh when you load those plugins, since they
# paint with ANSI color names that the terminal maps to its own palette
# Source this file after the plugins in ~/.zshrc, then run: source ~/.zshrc
# Generated by scripts/build-extras.lua from lua/cutiepro/palette.lua, do not edit

# Approximate colors only when 24-bit is unavailable
[[ $COLORTERM == (truecolor|24bit) ]] || zmodload zsh/nearcolor 2>/dev/null

ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#88847f'

typeset -gA ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES+=(
	default                        'fg=#d5d0c9'
	unknown-token                  'fg=#f56e7f'
	reserved-word                  'fg=#f56e7f'
	bracket-error                  'fg=#f56e7f'
	comment                        'fg=#88847f'

	precommand                     'fg=#c3a6cb'
	command                        'fg=#c3a6cb'
	alias                          'fg=#c3a6cb'
	suffix-alias                   'fg=#c3a6cb'
	global-alias                   'fg=#c3a6cb'
	function                       'fg=#c3a6cb'
	hashed-command                 'fg=#c3a6cb'
	arg0                           'fg=#c3a6cb'
	builtin                        'fg=#c3a6cb,italic'

	commandseparator               'fg=#e8d6a7'
	redirection                    'fg=#e8d6a7'
	globbing                       'fg=#e8d6a7'
	history-expansion              'fg=#e8d6a7'
	path_pathseparator             'fg=#e8d6a7'
	path_prefix_pathseparator      'fg=#e8d6a7'
	back-quoted-argument           'fg=#e8d6a7'
	back-quoted-argument-delimiter 'fg=#e8d6a7'

	autodirectory                  'fg=#e5a1a3'
	path                           'fg=#e5a1a3'
	path_prefix                    'fg=#e5a1a3'
	single-hyphen-option           'fg=#e5a1a3'
	double-hyphen-option           'fg=#e5a1a3'
	assign                         'fg=#e5a1a3'
	named-fd                       'fg=#e5a1a3'

	single-quoted-argument         'fg=#bec975'
	double-quoted-argument         'fg=#bec975'
	dollar-quoted-argument         'fg=#bec975'

	rc-quote                       'fg=#80c5de'
	dollar-double-quoted-argument  'fg=#80c5de'
	back-double-quoted-argument    'fg=#80c5de'
	back-dollar-quoted-argument    'fg=#80c5de'
	numeric-fd                     'fg=#80c5de'
)
